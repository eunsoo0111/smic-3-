{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "equity-study tracking_register.json (S4) — 참조 write-up 의 트래킹 레지스터 형식 계승",
  "type": "object",
  "required": ["ticker", "asof", "principles", "metrics", "flip_table", "calendar"],
  "properties": {
    "ticker": {"type": "string"}, "asof": {"type": "string"},
    "principles": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "metrics": {"type": "array", "minItems": 3, "items": {"type": "object",
      "required": ["id", "group", "metric", "feeds", "source", "cadence", "ai_step", "now", "bull", "downside", "action", "next_date"],
      "properties": {"id": {"type": "string"}, "feeds": {"type": "string", "minLength": 3}, "ai_step": {"type": "string"}, "next_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$"}}}},
    "flip_table": {"type": "array", "minItems": 2, "items": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "string"}}},
    "calendar": {"type": "array", "minItems": 2, "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}}}
  }
}
