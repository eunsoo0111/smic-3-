{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "equity-study narrative.json (S0)",
  "type": "object",
  "required": ["ticker", "name", "asof", "market_narratives", "our_hypotheses", "drivers", "key_questions", "what_we_do_not_know", "approved_by"],
  "properties": {
    "ticker": {"type": "string"}, "name": {"type": "string"}, "asof": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "market_narratives": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["id", "claim", "who_says", "grade", "priced_in", "evidence"],
      "properties": {"id": {"type": "string", "pattern": "^MN\\d+$"}, "claim": {"type": "string", "minLength": 10}, "who_says": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "grade": {"enum": ["①", "②", "③"]}, "priced_in": {"enum": ["yes", "partial", "no", "unknown"]}, "evidence": {"type": "string", "minLength": 5}}}},
    "our_hypotheses": {"type": "array", "minItems": 3, "items": {"type": "object", "required": ["id", "claim", "depends_on", "test", "metric", "falsify", "priority"],
      "properties": {"id": {"type": "string", "pattern": "^H\\d+$"}, "claim": {"type": "string", "minLength": 10}, "depends_on": {"type": "array", "items": {"type": "string"}},
        "test": {"type": "string", "minLength": 10}, "metric": {"type": "string", "minLength": 2}, "falsify": {"type": "string", "minLength": 5}, "priority": {"type": "integer", "minimum": 1},
        "model_links": {"type": "array", "items": {"$ref": "#/$defs/model_link"}, "description": "⭐ 2026-10-20 테제 링크 — 선택. 검사 = check_thesis_model.py"}}}},
    "drivers": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["name", "axis", "current", "moves"],
      "properties": {"name": {"type": "string"}, "axis": {"type": "object", "required": ["measure", "currency"], "properties": {"measure": {"enum": ["amount", "quantity", "index", "ratio"]}, "currency": {"enum": ["KRW", "USD", "JPY", "CNY", "EUR", "contract", "index_base", "n/a"]}}},
        "current": {"type": "object", "required": ["v", "asof", "source"]}, "moves": {"enum": ["eps", "multiple", "both"]}}}},
    "key_questions": {"type": "array", "minItems": 3, "maxItems": 5, "items": {"type": "string", "minLength": 8}},
    "what_we_do_not_know": {"type": "array", "items": {"type": "string"}},
    "approved_by": {"type": ["string", "null"]},
    "s2_review_by_main": {"type": ["string", "null"]},
    "review_check": {"type": "object", "required": ["checked_by", "checked_at", "checks", "findings", "verdict", "review_sha256"],
      "properties": {
        "checked_by": {"type": "string", "minLength": 1},
        "checked_at": {"type": "string"},
        "checks": {"type": "object", "required": ["c1_world_exists", "c2_true_but_fires", "c3_false_but_passes", "c4_and_leg_missing", "c5_base_fires_and_first_date", "c6_names_match"],
          "properties": {
            "c1_world_exists": {"enum": ["pass", "fail", "na"]}, "c2_true_but_fires": {"enum": ["pass", "fail", "na"]},
            "c3_false_but_passes": {"enum": ["pass", "fail", "na"]}, "c4_and_leg_missing": {"enum": ["pass", "fail", "na"]},
            "c5_base_fires_and_first_date": {"enum": ["pass", "fail", "na"]}, "c6_names_match": {"enum": ["pass", "fail", "na"]},
            "c5_exception_reason": {"type": "string", "minLength": 1, "description": "⭐ 확장(24-e, equity-study SKILL §1-B c5 설계 예외) — c5=na 일 때만: 시장 내재 경로가 Bear 아래라는 판정문 인용(예: 내재 ROE < Bear 케이스). 선택 필드, 스키마 required 에는 없음"}}},
        "findings": {"type": "array", "items": {"type": "string"}},
        "verdict": {"enum": ["pass", "fail"]},
        "review_sha256": {"type": "string", "pattern": "^[0-9a-f]{12}$"}
      }},
    "created": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "S0 착수일(YYYY-MM-DD, 달력 검증). 2026-10-05 이후 만드는 narrative.json 은 필수 — 없고 git 최초 추가일 ≥ 2026-10-05 면 오류. 관문 날짜 = created 와 git 최초 추가일 중 늦은 쪽(asof 는 안 씀)."},
    "business_nature": {"type": "object", "required": ["one_liner", "what_matters_most", "what_matters_less", "evidence", "approved_by"], "description": "⭐ 2026-10-20 선택 칸 — price_drivers 경중의 전제. approved_by null = 서브 초안·본체 승인 대기(check_study 관측).", "properties": {"one_liner": {"type": "string", "minLength": 10}, "what_matters_most": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}}, "what_matters_less": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}}, "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}}, "approved_by": {"type": ["string", "null"]}}},
    "price_drivers": {"type": "array", "minItems": 1, "description": "⭐ 2026-10-20 선택 칸 — 경중 순 드라이버 표. 원천 = tools/study/price_drivers.py 산출(drivers_attribution.json) + 증거 팩, 작성 = price-driver-scout 서브. kind 는 열린 낱말(알려진 값: event·sector_basket·orders·earnings·flow·narrative·macro·trend_index·fandom/core_customer) — 목록 밖이면 kind_note 필수. check_study: 있을 때만 weight_pct 합 100±5·kind/kind_note·evidence ≥1(날짜·ref)·falsify 를 검사.", "items": {"type": "object", "required": ["driver", "kind", "weight_pct", "evidence", "grade", "falsify"], "properties": {"driver": {"type": "string", "minLength": 3}, "kind": {"type": "string", "minLength": 2}, "kind_note": {"type": "string", "minLength": 3}, "weight_pct": {"type": "number", "minimum": 0, "maximum": 100}, "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["date", "ref"], "properties": {"date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}, "ref": {"type": "string", "minLength": 3}}}}, "grade": {"enum": ["①", "②", "③", "미측정"]}, "falsify": {"type": "string", "minLength": 5}, "basis": {"type": "string", "description": "비중의 분모(예: 상위 변동일 Σ|r| · 분산 R²)"}}}},
    "cycle_context": {"$ref": "#/$defs/cycle_context"}, "blind_contrast": {"$ref": "#/$defs/blind_contrast"}, "chain_position": {"$ref": "#/$defs/chain_position"}
  },
  "$defs": {
    "model_link": {"type": "object", "required": ["driver", "direction", "case", "horizon"], "description": "가설 하나가 모델 드라이버 경로에 어떻게 들어가야 하나(2026-10-20). driver = 모델 산출 paths 의 키(rev·op·opm·eps·<세그먼트>; opm/npm/gpm 은 op/rev 등으로 유도), case = base|bull|bear|all 또는 세상 슬러그, horizon = FY27|2y 등, vs = anchor(기준 실적 연도, 기본)|consensus.", "properties": {"driver": {"type": "string", "minLength": 2}, "direction": {"enum": ["up", "down", "flat"]}, "case": {"type": "string", "minLength": 3}, "horizon": {"type": "string", "pattern": "^(FY\\d{2,4}E?|\\d+y)$"}, "note": {"type": "string"}, "vs": {"enum": ["anchor", "consensus"]}, "from": {"type": "string", "pattern": "^FY\\d{2,4}E?$"}, "tol": {"type": "number", "minimum": 0}}},
    "cycle_context": {"type": "object", "required": ["searched", "items"], "description": "⭐ 2026-10-05 이음매 계약 — 사이클(상시 레인)의 내러티브 편을 찾았는지·무엇을 찾았는지·채택/기각했는지. n_found 0 + 검색 키 기록 = 「관련 편 없음」(유효), 블록 없음 = 「안 찾아봤다」(무효).", "properties": {"searched": {"type": "object", "required": ["tickers", "boxes", "sources", "n_found"], "properties": {"tickers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "boxes": {"type": "array", "items": {"type": "string", "minLength": 3}, "description": "node.json chain_refs 의 box_id"}, "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3, "pattern": "\\S"}, "description": "실제로 훑은 경로(node_narratives.json·narratives/*.md frontmatter tickers·expectation_ledger·catalysts)"}, "n_found": {"type": "integer", "minimum": 0}, "asof": {"type": "string"}}}, "items": {"type": "array", "items": {"type": "object", "required": ["narrative_id", "ref", "asof", "stance", "why"], "properties": {"narrative_id": {"type": "string", "minLength": 2}, "ref": {"type": "string", "minLength": 3, "description": "레포 상대 경로(market-intel/narratives/<id>.md 등)"}, "asof": {"type": "string", "minLength": 4}, "stance": {"enum": ["adopt", "reject", "irrelevant"]}, "why": {"type": "string", "minLength": 10, "pattern": "\\S"}, "found_via": {"type": "string"}, "maps_to": {"type": "array", "items": {"type": "string"}, "description": "이 편이 닿는 MN/H id"}}, "allOf": [{"if": {"properties": {"stance": {"const": "adopt"}}}, "then": {"required": ["maps_to"], "properties": {"maps_to": {"minItems": 1}}}}]}}}},
    "blind_contrast": {"type": "object", "required": ["backend", "model", "prompt_ref", "prompt_sha", "output_ref", "made_before_s0_synthesis", "only_blind", "only_ours", "both"], "description": "⭐ 2026-10-05 이음매 계약 — S0 합성 전에 회사명+티커+기준일만 준 무하네스 호출(외부 모델) 결과와 우리 판의 차이표. only_blind 는 항목마다 disposition 필수. 실호출 전이면 status 「not_run — …」 (신규 팩에선 오류). check_study 는 출력 파일 위치·프롬프트 해시·프롬프트 금칙(서사/가설 id·레포 경로·셀사이드)·차이표 비어 있음·커밋 순서(프롬프트 ≤ 출력 ≤ narrative.json 최초 커밋)를 대조한다.", "properties": {"status": {"type": "string"}, "backend": {"type": "string", "minLength": 2}, "model": {"type": "string", "minLength": 2}, "prompt_sha": {"type": "string", "pattern": "^[0-9a-f]{12,64}$"}, "output_ref": {"type": "string", "pattern": "S0_blind_[\\w.-]+\\.(md|txt|json)$", "description": "팩 study/ 안의 S0_blind_* 산출 파일"}, "made_before_s0_synthesis": {"const": true}, "made_at": {"type": "string"}, "only_blind": {"type": "array", "items": {"type": "object", "required": ["claim", "disposition", "why"], "properties": {"claim": {"type": "string", "minLength": 5}, "disposition": {"enum": ["adopted", "rejected", "needs_check"]}, "why": {"type": "string", "minLength": 5}}}}, "only_ours": {"type": "array", "items": {"type": "object", "required": ["claim"], "properties": {"claim": {"type": "string", "minLength": 5}, "why": {"type": "string"}}}}, "both": {"type": "array", "items": {"type": "object", "required": ["claim"], "properties": {"claim": {"type": "string", "minLength": 5}, "why": {"type": "string"}}}}, "prompt_ref": {"type": "string", "minLength": 3, "description": "팩 안의 프롬프트 파일(회사명·티커·기준일만) — prompt_sha 는 이 파일의 sha256 앞자리와 대조된다"}, "audit_ref": {"type": "string", "description": "선택: 외부 호출 감사 기록 경로(없을 수 있다)"}, "stages": {"type": "array", "items": {"$ref": "#/$defs/blind_stage"}, "description": "⭐ 2026-10-20 선택 칸 — 판단 스테이지별 무하네스 짝. 위 S0 칸은 그대로 정본(S0 단일 객체 호환), S0b·S2_consensus·S1·S3 짝을 여기 쌓는다. check_study: price_drivers 있으면 S0b, consensus_check.json 있으면 S2_consensus 필수 — 관측 기본, --strict-blind·S0 착수 2026-11-01 이후는 rc 1."}}},
    "blind_stage": {"type": "object", "required": ["stage", "backend", "model", "prompt_ref", "prompt_sha", "output_ref", "made_before_synthesis", "only_blind", "only_ours", "both"], "description": "무하네스 짝 한 스테이지 — S0 블록과 같은 꼴 + stage. 재료(표)만 주고 웹·표 밖 자료 금지(외부 호출기가 *_blind_prompt 파일에 web off 기본). output_ref = 팩 study 안 <stage>_blind_*. 「합성 전」 = 출력 최초 커밋 ≤ S0b: narrative.json / S2_consensus: consensus_check.json 최초 커밋.", "properties": {"stage": {"enum": ["S0", "S0b", "S2_consensus", "S1", "S3"]}, "status": {"type": "string"}, "backend": {"type": "string", "minLength": 2}, "model": {"type": "string", "minLength": 2}, "prompt_ref": {"type": "string", "minLength": 3}, "prompt_sha": {"type": "string", "pattern": "^[0-9a-f]{12,64}$"}, "output_ref": {"type": "string", "pattern": "^(S0|S0b|S2_consensus|S1|S3)_blind_[\\w.-]+\\.(md|txt|json)$"}, "made_before_synthesis": {"type": "boolean"}, "made_at": {"type": "string"}, "harness_ref": {"type": "string"}, "material": {"type": "string"}, "web_used": {"type": "boolean", "description": "짝이 웹·표 밖 원천을 썼다(true = 「재료만」 깨짐, 검사기 문제로 센다)"}, "web_note": {"type": "string"}, "audit_ref": {"type": "string"}, "only_blind": {"type": "array", "items": {"type": "object", "required": ["claim", "disposition", "why"], "properties": {"claim": {"type": "string", "minLength": 5}, "disposition": {"enum": ["adopted", "rejected", "needs_check"]}, "why": {"type": "string", "minLength": 5}}}}, "only_ours": {"type": "array", "items": {"type": "object", "required": ["claim"], "properties": {"claim": {"type": "string", "minLength": 5}, "why": {"type": "string"}}}}, "both": {"type": "array", "items": {"type": "object", "required": ["claim"], "properties": {"claim": {"type": "string", "minLength": 5}, "why": {"type": "string"}}}}}},
    "chain_position": {"type": "object", "required": ["boxes", "upstream", "downstream", "what_company_does", "who_pays_whom", "concentration", "bottlenecks", "substitutes", "value_capture", "q_asp_to_pnl", "stale_facts", "sources"], "description": "⭐ 2026-10-05 이음매 계약 — core/valuechain/*.yaml 박스·간선에서 출발한 회사의 체인 위치. 보고서 본문 「Value chain position」 절의 원천.", "properties": {"boxes": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$"}}, "upstream": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "what", "share_or_dependence", "source", "asof"], "properties": {"name": {"type": "string", "minLength": 2}, "what": {"type": "string", "minLength": 2}, "share_or_dependence": {"type": "string", "minLength": 2, "description": "매출·매입 비중(%·기준연도) 또는 의존 서술. 모르면 「모름 — <부류>(<상세>)」"}, "source": {"type": "string", "minLength": 3}, "asof": {"type": "string"}}}}, "downstream": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "what", "share_or_dependence", "source", "asof"], "properties": {"name": {"type": "string", "minLength": 2}, "what": {"type": "string", "minLength": 2}, "share_or_dependence": {"type": "string", "minLength": 2, "description": "매출·매입 비중(%·기준연도) 또는 의존 서술. 모르면 「모름 — <부류>(<상세>)」"}, "source": {"type": "string", "minLength": 3}, "asof": {"type": "string"}}}}, "what_company_does": {"type": "string", "minLength": 20}, "who_pays_whom": {"type": "string", "minLength": 20}, "concentration": {"type": "object", "required": ["customers", "suppliers"], "properties": {"customers": {"type": "string", "minLength": 5}, "suppliers": {"type": "string", "minLength": 5}}}, "bottlenecks": {"oneOf": [{"type": "string", "minLength": 10, "pattern": "\\S"}, {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 10, "pattern": "\\S"}}]}, "substitutes": {"oneOf": [{"type": "string", "minLength": 10, "pattern": "\\S"}, {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 10, "pattern": "\\S"}}]}, "value_capture": {"type": "string", "minLength": 20, "description": "체인의 마진이 어디에 앉고 왜인가"}, "q_asp_to_pnl": {"type": "string", "minLength": 20, "description": "Q·ASP·점유가 매출·마진에 닿는 경로와 시차"}, "stale_facts": {"type": "array", "items": {"type": "object", "required": ["field", "asof"], "properties": {"field": {"type": "string"}, "asof": {"type": "string"}, "note": {"type": "string"}}}}, "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3, "pattern": "\\S"}}, "proposals": {"type": "array", "items": {"type": "string"}, "description": "yaml 에 없어 core/valuechain/_inbox/ 에 낸 chain-proposal@1 행 경로"}}}
  }
}
